# ==========================================================
# MiCancha — Backend (Express + MySQL)
# Copia este archivo a ".env" y completa los valores reales.
# ==========================================================

# Servidor
PORT=4000
NODE_ENV=development

# Base de datos (local o Aiven MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=root
DB_NAME=micancha
# Conexión cifrada (obligatorio en Aiven). true/false
DB_SSL=false
# Ruta al certificado CA de Aiven (opcional, recomendado en producción)
# DB_CA_PATH=./ca.pem

# Auth
# Genera un valor largo y aleatorio. Ejemplo rápido:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# CORS (orígenes del frontend separados por coma)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate limiting sobre login/register
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=5

# Usuario admin semilla (solo se usa al ejecutar: npm run seed)
ADMIN_EMAIL=admin@micancha.pe
ADMIN_PASSWORD=admin123456
ADMIN_NOMBRE=Administrador
